# AI-консультант. Скопируйте файл в backend/.env и подставьте свой ключ.
# Ключ: https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Необязательно: модель вместо бесплатной по умолчанию.
# Бесплатные помечены суффиксом :free, слаг openrouter/free выбирает
# бесплатную модель автоматически.
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
